<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.superprojector.home" android:versionCode="1" android:versionName="0.1">
    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="33"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <application android:label="Inicio" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".HomeActivity" android:exported="true" android:launchMode="singleTask"
            android:stateNotNeeded="true" android:clearTaskOnLaunch="true" android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity android:name=".AppsActivity" android:exported="false"/>
        <activity android:name=".FocusActivity" android:exported="true"/>
        <activity android:name=".KeystoneActivity" android:exported="true"/>
        <activity android:name=".ShareActivity" android:exported="true"/>
        <activity android:name=".QuickPanelActivity" android:exported="true" android:launchMode="singleInstance"
            android:excludeFromRecents="true" android:theme="@android:style/Theme.Translucent.NoTitleBar"/>
        <service android:name=".ClockDream" android:exported="true" android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter><action android:name="android.service.dreams.DreamService"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream"/>
        </service>
        <service android:name=".QuickKeys" android:exported="true" android:label="Panel rápido" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/quick_keys"/>
        </service>
        <activity android:name=".InputActivity" android:exported="true"/>
        <activity android:name=".SettingsActivity" android:exported="true"/>
        <activity android:name=".WatchActivity" android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize"/>
    </application>
</manifest>
